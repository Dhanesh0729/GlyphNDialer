<!--
    :feature:calllog manifest.

    The Recents/Call-log feature reads the platform call log, deletes entries,
    places call-backs, and blocks numbers. Per CONVENTIONS.md §8 each module
    declares the permissions it needs; manifest merging combines them into :app,
    which owns the runtime-request flow (with rationale UI). WRITE_CALL_LOG and
    the BlockedNumberContract operations only take effect when the app holds the
    default-dialer role.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

</manifest>
