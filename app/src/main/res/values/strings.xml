<resources>
    <string name="app_name">Glyph Dialer</string>

    <!--
      Nothing Glyph Developer Kit API key (BUILD_SPEC §17.1). The :peripheral:glyph
      manifest declares the NothingKey meta-data that reads this string; we provide the
      resource here in the application module so it resolves at merge time.

      "test" is accepted by the GDK for debug builds (auto-expires after 48h). REPLACE
      with a real key issued by the Nothing Developer Programme for production. On
      non-Nothing hardware the key is irrelevant — the GlyphController no-ops (§9).
    -->
    <string name="nothing_api_key" translatable="false">test</string>

    <!-- WebRTC signaling defaults. Replace these for production in-app audio/video calls. -->
    <string name="webrtc_signaling_scheme" translatable="false">wss</string>
    <string name="webrtc_signaling_host" translatable="false">signaling.invalid.glyphdialer.example</string>
    <string name="webrtc_signaling_port" translatable="false">443</string>
    <string name="webrtc_signaling_path" translatable="false">/rtc/{session}</string>
    <string name="webrtc_signaling_auth_token" translatable="false"></string>
</resources>
