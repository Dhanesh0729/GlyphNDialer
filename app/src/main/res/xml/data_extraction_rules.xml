<!--
  Android 12+ data extraction rules (cloud backup + device-to-device transfer).
  Exclude sensitive call data from both channels; mirror backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="glyph_dialer.db" />
        <exclude domain="file" path="recordings/" />
        <exclude domain="file" path="transcripts/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="recordings/" />
    </device-transfer>
</data-extraction-rules>
