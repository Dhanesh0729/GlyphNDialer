# Release signing configuration TEMPLATE for Glyph Dialer.
#
# HOW TO USE
#   1. Copy this file to `keystore.properties` in the project root.
#   2. Fill in the real values for your release keystore.
#   3. NEVER commit keystore.properties or the .jks/.keystore file — both are
#      already gitignored (see .gitignore: keystore.properties, *.jks, *.keystore).
#
# The :app module's signingConfigs block reads these keys at configure time, e.g.:
#
#       val ksPropsFile = rootProject.file("keystore.properties")
#       if (ksPropsFile.exists()) {
#           val ksProps = Properties().apply { load(ksPropsFile.inputStream()) }
#           signingConfigs.create("release") {
#               storeFile = file(ksProps.getProperty("storeFile"))
#               storePassword = ksProps.getProperty("storePassword")
#               keyAlias = ksProps.getProperty("keyAlias")
#               keyPassword = ksProps.getProperty("keyPassword")
#           }
#       }
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore release.jks -alias glyphdialer \
#           -keyalg RSA -keysize 2048 -validity 10000

# Path to the keystore file, relative to the project root (or absolute).
storeFile=release.jks

# Password protecting the keystore.
storePassword=CHANGE_ME

# Alias of the signing key inside the keystore.
keyAlias=glyphdialer

# Password protecting that specific key (often same as storePassword).
keyPassword=CHANGE_ME
